{
  "language": "bn",
  "sections": {
    "1": {
      "status": "ready",
      "title": "কবিতা ১",
      "stanzas": [
        [
          "সব ঠিক ছিল—",
          "গরু চরছিল",
          "সারা মাঠে,",
          "চারণভূমির গালিচায়।"
        ],
        [
          "ঘাসফুল ফুটছিল",
          "হরেক রঙে।",
          "রাখাল ছেলে",
          "কদমের ডাল থেকে",
          "শিস দিচ্ছিল;",
          "সাপ আর সরীসৃপেরা",
          "গান শুনছিল।",
          "ঝগড়া শুরু হল,",
          "কামিনী-কাঞ্চন কিছুই ছিল না;",
          "ঝগড়া বাড়ল।"
        ],
        [
          "ভাবনা জাগল:",
          "ঘটে যাবে কি",
          "কোনো অঘটন?",
          "জ্বলে যাবে কি গ্রাম, খেত আর বন?",
          "গা থেকে কাপড় উড়িয়ে নেবে কি হাওয়া?",
          "মিলিয়ে যাবে কি",
          "কদমের ডাল থেকে ভেসে আসা বাঁশির সুর?",
          "টুকরো টুকরো হয়ে ঝরে পড়বে কি",
          "আকাশ আর তারারা?",
          "উড়ে যাবে কি",
          "এক মুঠো ছাই হয়ে",
          "প্রচণ্ড সূর্যের তেজ আর অহংকার?",
          "ছিঁড়ে যাবে কি",
          "মনের সঙ্গে মন জুড়ে দেওয়ার",
          "সব সুতো?",
          "অরাজকতার অজগর",
          "গিলে ফেলবে কি",
          "দেশ আর শাসন?"
        ],
        [
          "আকাশজোড়া এই আশঙ্কাকে মিথ্যে করে,",
          "কোথায় ছিল কে জানে,",
          "দৌড়ে এল",
          "সোনালি সকালের মতো",
          "সুঠাম এক যুবক।",
          "উঁচু মাটির ঢিবি থেকে",
          "হুকুম দিল রাজার ভঙ্গিতে।",
          "সঙ্গীসাথিরা প্রজার মতো",
          "বসে রইল নিচে;",
          "মুহূর্তেই থেমে গেল",
          "হট্টগোল।"
        ],
        [
          "বিক্রমাদিত্যদের",
          "কোনো কারসাজি ছিল না।",
          "মাটি খুঁড়তে খুঁড়তে জানা গেল—",
          "উঁচু মাটির ঢিবির নিচে",
          "সিংহাসন লুকিয়ে ছিল।"
        ]
      ]
    },
    "21": {
      "status": "ready",
      "title": "কবিতা ২১",
      "stanzas": [
        [
          "দেবতারাও",
          "কম বুঝদার ছিলেন না!",
          "মাঝে মাঝে",
          "কাউকে কিছু না বলে",
          "কালো ঘোড়া, সাদা ঘোড়ায় চড়ে",
          "বেরিয়ে পড়তেন",
          "দিগ্বিজয়ে।"
        ],
        [
          "কাহিনি",
          "রোমাঞ্চকর হয়ে উঠত,",
          "দুধ-বিক্রেতার হাতে",
          "রত্নের আংটি পরিয়ে দিয়ে",
          "যখন দুধের হাঁড়ি থেকে",
          "দুধ আর অবশিষ্টটুকুও",
          "নিঃশেষে তুলে নিতেন গোঁসাইরা,",
          "গোপনে।",
          "মহারাজার পরাক্রম",
          "হাজার ক্রোশ ছড়িয়ে পড়ত",
          "মুখে মুখে:",
          "ঠাকুর, রাজার সেবায়!"
        ],
        [
          "অমন একটা কাহিনি",
          "গড়া না হলে,",
          "বলো তো,",
          "এই আধগড়া কাঠের পুতুলকে,",
          "এই অবোধ মূর্তিকে,",
          "কে কেন",
          "ভোগ দিত",
          "বড় দেউলে,",
          "রত্নবেদিতে,",
          "অবোধ শিশুর",
          "সরল বিশ্বাসে?"
        ]
      ]
    },
    "24": {
      "status": "ready",
      "title": "কবিতা ২৪",
      "stanzas": [
        [
          "কে প্রজা, কে রাজা?",
          "কে কপিলা, কে কপিলেশ্বর?"
        ],
        [
          "হাতির শুঁড়ের কলস থেকে জল ঝরলেই",
          "ভাগ্য বদলে যায়।",
          "রাখাল ছেলে স্বপ্নের মতো",
          "হয়ে যায়",
          "গজপতি, পশুপতিপতি, বীরাধিবীরবর,",
          "রাজরাজেশ্বর…"
        ],
        [
          "একবার সিংহাসনে",
          "বসে পড়লে",
          "আর দেখা মেলে না",
          "কপিলার।",
          "কাশিয়াদের সিংহদুয়ার থেকে",
          "ফিরে আসার দৃশ্য দেখে",
          "একদল অকর্মণ্য মানুষ,",
          "যখন বিচিত্র ভঙ্গিতে",
          "বাধা দেয়",
          "গোঁফওয়ালা কোটাল আর সশস্ত্র দ্বারপাল।"
        ]
      ]
    }
  }
}
