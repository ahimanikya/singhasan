# Publish the self-contained website, keeping local working material outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/design-system/
!/.github/
!/site/
site/__pycache__/
site/EDITORIAL-PREFERENCES.txt
**/.DS_Store
**/*.pyc
**/.env*
site/.openai/
site/services/node_modules
site/services/*debug.log
site/services/.firebase/
